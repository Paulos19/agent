# ================================================================
# EXEMPLO DE CONFIGURAÇÕES - RENOMEIE PARA .env
# ================================================================

# --- IA (Google Gemini) ---
GEMINI_API_KEY=sua_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

ALLOWED_USERS=5511999999999,123456789

# --- CONEXÃO HÍBRIDA COM O PC PESSOAL (WEBSOCKET WORKER) ---
WORKER_SECRET=devops_secret_token_123
VPS_WS_URL=wss://agent.phdev.top/ws/worker

# --- DIRETÓRIO DE TRABALHO ---
WORKSPACE_DIR=./workspace

# --- EVOLUTION API (WHATSAPP) ---
EVOLUTION_API_URL=https://evo.seusite.com
EVOLUTION_API_KEY=sua_global_api_key
EVOLUTION_INSTANCE_NAME=assistente

# --- TELEGRAM BOT ---
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token

# --- DISPARO DE E-MAIL (SMTP) ---
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_SECURE=true
EMAIL_SERVER_USER=seu-email@gmail.com
EMAIL_SERVER_PASSWORD=sua-senha-de-app
EMAIL_FROM=Nome <seu-email@gmail.com>

# --- SERVIDOR FASTAPI ---
HOST=0.0.0.0
PORT=8000
