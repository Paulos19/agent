# ================================================================
# EXEMPLO DE CONFIGURAÇÕES - RENOMEIE PARA .env
# ================================================================

# --- IA (Google Gemini) ---
GEMINI_API_KEY=sua_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Números com acesso total de Administrador/Operador (DevOps, comandos de PC, terminal, IA)
ALLOWED_USERS=5511999999999,123456789

# Números de Convidados autorizados EXCLUSIVAMENTE para download de músicas/mídias (YouTube, Reels, TikTok, etc.)
# Mensagens normais sem link são ignoradas em silêncio absoluto para evitar qualquer conflito pessoal no WhatsApp.
# A mídia é entregue diretamente no chat da pessoa que pediu com link de 48h.
GUEST_USERS=5561999998888,5511999997777

# --- CONEXÃO HÍBRIDA COM O PC PESSOAL (WEBSOCKET WORKER) ---
WORKER_SECRET=devops_secret_token_123
VPS_WS_URL=wss://agent.phdev.top/ws/worker

# --- DIRETÓRIO DE TRABALHO ---
WORKSPACE_DIR=./workspace

# --- EVOLUTION API (WHATSAPP) ---
EVOLUTION_API_URL=https://evo.seusite.com
EVOLUTION_API_KEY=sua_global_api_key
EVOLUTION_INSTANCE_NAME=assistente

# --- TELEGRAM BOT ---
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token

# --- DISPARO DE E-MAIL (SMTP) ---
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_SECURE=true
EMAIL_SERVER_USER=seu-email@gmail.com
EMAIL_SERVER_PASSWORD=sua-senha-de-app
EMAIL_FROM=Nome <seu-email@gmail.com>

# --- SERVIDOR FASTAPI ---
HOST=0.0.0.0
PORT=8000

# --- DEVOPS: EASYPANEL DEPLOY WEBHOOKS ---
# Webhook copiado da aba Deployments do seu serviço no Easypanel
EASYPANEL_DEPLOY_PHDEV_WEBHOOK=https://easypanel.host/api/deploy/...
# Webhook do serviço do assistente (para redeploy via GitHub Webhook):
EASYPANEL_DEPLOY_WEBHOOK=https://easypanel.host/api/deploy/...
# Ou mapa JSON com múltiplos serviços:
# EASYPANEL_DEPLOY_WEBHOOKS={"phdev": "https://...", "meuapp": "https://..."}

# --- DEVOPS: SSH NO HOST DA VPS (Opcional) ---
VPS_SSH_HOST=seu_ip_da_vps
VPS_SSH_PORT=22
VPS_SSH_USER=root
VPS_SSH_PASS=sua_senha_root_ou_vps

# --- GITHUB WEBHOOK AUTO-DEPLOY ---
# Secret gerado para o webhook do GitHub (Settings → Webhooks → Add webhook)
# Use: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=seu_secret_aqui
